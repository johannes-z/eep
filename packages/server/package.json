{
  "name": "@eep/server",
  "version": "1.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run generate-routes && bun scripts/build.js && bun build ./src/index.ts --outdir ./dist --target bun --external bun-serialport && bun build ./src/main.ts --outdir ./dist --target bun --external bun-serialport",
    "build:release": "bun run generate-routes && bun scripts/build-release.js",
    "dev": "bun run generate-routes && bun --watch ./scripts/dev.js",
    "generate-routes": "tsr generate --project tsconfig.json --write",
    "start": "bun dist/main.js",
    "test": "bun test ./src",
    "typecheck": "bun run generate-routes && bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "bun-serialport": "0.2.0",
    "mqtt": "^5.16.0",
    "polycrc": "1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.38",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2"
  }
}
